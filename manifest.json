{
  "manifest_version": 3,
  "name": "AutoDL GPU Availability Monitor",
  "version": "1.0.0",
  "description": "Monitor rented AutoDL instances and notify when GPU becomes available.",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://www.autodl.com/*", "https://console.autodl.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoDL GPU Monitor",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.autodl.com/console/instance*", "https://console.autodl.com/console/instance*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
